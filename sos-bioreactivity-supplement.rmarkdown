# Individual-Difference Measures × Raw Biomarker Levels

*Self-containment cross-check of the primary notebook's Aim 2/Aim 3 raw-biomarker-level correlations (pubertal status, pubertal timing, BFNES, CES-DC × log-transformed biomarker concentration at each of the four timepoints), rebuilt here from this notebook's own independently-loaded data rather than copied from the primary notebook's output.*




```{r indiff-levels-setup, echo=FALSE}
# Individual-difference measures not otherwise loaded in this supplement --
# BFNES (fear of negative evaluation) and CES-DC (depressive symptoms) totals.
# Definitions match the primary notebook (Aim 3a/3b) exactly. Also needed by
# Section S3 below (AUCi peak-vs-AUCi head-to-head tables), which reuses these
# same objects rather than reloading them.
quest_raw_q <- read.csv(file.path(proj_path, "data", "SOS_questionnaire_data.csv"))

dep <- read.csv(file.path(
  data_path,
  "SOS/SOS-study-monash/questionnaires/CESD_total.csv"
)) |>
  select(SampleID, CESD_total)

bfnes <- quest_raw_q |>
  select(SampleID = SID, starts_with("BFNES_")) |>
  mutate(across(starts_with("BFNES_"), \(x) suppressWarnings(as.numeric(x)))) |>
  mutate(
    BFNES_2     = 6 - BFNES_2,   # reverse-scored items: 2, 4, 7
    BFNES_4     = 6 - BFNES_4,   # BFNES_10 forward-scored in raw data (not reversed)
    BFNES_7     = 6 - BFNES_7,
    BFNES_total = rowSums(across(starts_with("BFNES_")), na.rm = FALSE)
  ) |>
  select(SampleID, BFNES_total)

biomarker_levels <- sos_crp_panel |>
  full_join(sos_cytokines_panel, by = c("SampleID", "Time")) |>
  full_join(sos_hormones_panel,  by = c("SampleID", "Time")) |>
  left_join(sos_puberty, by = "SampleID") |>
  left_join(timing_df |> select(SampleID, age_menarche_c, PDS_F5), by = "SampleID") |>
  left_join(bfnes, by = "SampleID") |>
  left_join(dep,   by = "SampleID") |>
  left_join(static_covariates |> select(SampleID, med_hormone_cytokine), by = "SampleID") |>
  mutate(med_hormone_cytokine_num = as.numeric(med_hormone_cytokine))

bio_vars <- c("CRP_log", "IL10_log", "IL6_log", "TNFalpha_log",
              "DHEA_log", "Testosterone_log", "Cortisol_log")

indiff_level_domain <- function(bv) if_else(
  bv %in% c("CRP_log", "IL10_log", "IL6_log", "TNFalpha_log"), "Immune", "Hormones"
)

# Shared helper for a simple (unadjusted) predictor x biomarker-level
# correlation table -- same shape as the primary notebook's puberty-levels-corr
# / bfnes-levels-corr / dep-levels-corr chunks, generalized over the predictor
# column name so it isn't repeated five times below.
run_levels_corr <- function(pred_var) {
  map_dfr(bio_vars, function(bv) {
    map_dfr(1:4, function(tp) {
      dat <- biomarker_levels |> filter(Time == tp) |>
        select(all_of(c(bv, pred_var))) |> na.omit()
      if (nrow(dat) < 5) return(NULL)
      ct <- cor.test(dat[[bv]], dat[[pred_var]])
      tibble(Biomarker = bv, Timepoint = paste0("T", tp),
             r = round(unname(ct$estimate), 3), p_raw = ct$p.value)
    })
  }) |>
    mutate(group = indiff_level_domain(Biomarker)) |>
    group_by(group) |>
    mutate(p_fdr = round(p.adjust(p_raw, method = "fdr"), 4)) |>
    ungroup()
}

print_levels_corr_table <- function(corr_long, caption) {
  # No add_header_above() -- it is not wrapped by this notebook's html/docx
  # cell_spec()/kable_styling() shims (see the S3/S4 sections above, which
  # avoid it for the same reason), and it breaks docx rendering here. Flat,
  # self-labeling column names (e.g. "T1 r") substitute for the grouped
  # T1-T4 header row used in the primary notebook's HTML-only version.
  corr_long |>
    pivot_wider(id_cols = Biomarker, names_from = Timepoint,
                values_from = c(r, p_fdr), names_glue = "{Timepoint}_{.value}") |>
    select(Biomarker, T1_r, T1_p_fdr, T2_r, T2_p_fdr, T3_r, T3_p_fdr, T4_r, T4_p_fdr) |>
    mutate(across(ends_with("_p_fdr"), \(x) cell_spec(
      round(x, 4), bold = !is.na(x) & x < 0.05,
      color = if_else(!is.na(x) & x < 0.05, "#2166ac", "black")
    ))) |>
    kable(escape = FALSE,
          col.names = c("Biomarker", "T1 r", "T1 p (FDR)", "T2 r", "T2 p (FDR)",
                        "T3 r", "T3 p (FDR)", "T4 r", "T4 p (FDR)"),
          caption = caption) |>
    kable_styling(bootstrap_options = "hover", full_width = FALSE)
}
```




## Pubertal Status, Timing, FNE, and CES-DC × Raw Biomarker Levels




```{r indiff-levels-tables, results='asis'}
indiff_predictors <- c(
  PUBcomp        = "Pubertal Status (Composite)",
  age_menarche_c = "Age at menarche (centered, years)",
  PDS_F5         = "PDS F5: perceived timing (1=much earlier, 5=much later)",
  BFNES_total    = "BFNES (Fear of Negative Evaluation)",
  CESD_total     = "CES-DC (Depressive Symptoms)",
  med_hormone_cytokine_num = "Hormone/Cytokine-Relevant Medication Use (0/1)"
)

for (pv in names(indiff_predictors)) {
  cat("\n\n###", indiff_predictors[[pv]], "\n\n")
  if (pv == "med_hormone_cytokine_num") {
    n_med_flagged <- sum(static_covariates$med_hormone_cytokine, na.rm = TRUE)
    cat("**Caveat.** Only", n_med_flagged, "of", nrow(static_covariates),
        "participants are flagged for hormone/cytokine-relevant medication use (see S2 above). This correlation is descriptive; with only", n_med_flagged,
        "in the flagged group, power is limited and a few participants' values can meaningfully shift the result -- treat any significant finding as hypothesis-generating, not confirmatory.\n\n")
  }
  run_levels_corr(pv) |>
    print_levels_corr_table(
      caption = paste0("Correlations: ", indiff_predictors[[pv]], " ", intToUtf8(215),
                        " biomarker levels (FDR-adjusted within immune/hormones, 16/12 tests pooling all 4 timepoints; bold = p_FDR < .05)")
    ) |>
    as.character() |>
    cat()
}
```




### Age-Adjusted Effect of Pubertal Status on Raw Biomarker Levels

Status-for-age (status controlling for age) -- the third pubertal-timing operationalization -- isolates the status-beyond-age effect the same way the age-adjusted reactivity models elsewhere in this document do. Age at menarche and PDS F5 are not re-tested here since they are used unadjusted above, matching the primary notebook's convention.




```{r indiff-levels-status-for-age}
biomarker_levels_age <- biomarker_levels |> left_join(age_df, by = "SampleID")

levels_joint_tbl <- map_dfr(bio_vars, function(bv) {
  map_dfr(1:4, function(tp) {
    dat <- biomarker_levels_age |>
      filter(Time == tp) |>
      select(all_of(c(bv, "PUBcomp", "age_at_session"))) |>
      na.omit()
    if (nrow(dat) < 5) return(NULL)
    fit <- lm(as.formula(paste(bv, "~ PUBcomp + age_at_session")), data = dat)
    broom::tidy(fit) |>
      filter(term == "PUBcomp") |>
      mutate(Biomarker = bv, Timepoint = paste0("T", tp), n = nrow(dat))
  })
}) |>
  mutate(group = indiff_level_domain(Biomarker)) |>
  group_by(group) |>
  mutate(p_fdr = round(p.adjust(p.value, method = "fdr"), 4)) |>
  ungroup() |>
  mutate(estimate = round(estimate, 3))

levels_joint_tbl |>
  pivot_wider(id_cols = Biomarker, names_from = Timepoint, values_from = c(estimate, p_fdr),
              names_glue = "{Timepoint}_{.value}") |>
  select(Biomarker, T1_estimate, T1_p_fdr, T2_estimate, T2_p_fdr, T3_estimate, T3_p_fdr, T4_estimate, T4_p_fdr) |>
  mutate(across(ends_with("_p_fdr"), \(x) cell_spec(
    x, bold = !is.na(x) & x < 0.05, color = if_else(!is.na(x) & x < 0.05, "#2166ac", "black")
  ))) |>
  kable(escape = FALSE,
        col.names = c("Biomarker", "T1 b", "T1 p (FDR)", "T2 b", "T2 p (FDR)",
                      "T3 b", "T3 p (FDR)", "T4 b", "T4 p (FDR)"),
        caption = "Effect of pubertal status on log biomarker level, controlling for age (FDR within immune/hormones, 16/12 tests; bold = p_FDR < .05)") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




---

# HR Subsample Comparison

*Heart-rate data are not available for every participant with biomarker data (see Aim 1b). This section checks whether participants with usable HR data differ systematically from those without it on age, pubertal status, BMI, or gender -- if they do, the HR-based reactivity results (and any comparison between HR and biomarker reactivity) would need to be interpreted with that selection difference in mind.*




```{r hr-subsample-setup, echo=FALSE}
hr_available_ids <- hr_difference |> filter(!is.na(task_rs_hr_diff)) |> pull(SampleID)

gender <- quest_raw_q |>
  select(SampleID = SID, FSMI_6, FSMI_6_4_TEXT) |>
  mutate(identity = case_when(
    FSMI_6 == 1 ~ "Male", FSMI_6 == 2 ~ "Female",
    FSMI_6 == 3 ~ "Questioning / unsure",
    FSMI_6 == 4 ~ str_to_sentence(str_trim(FSMI_6_4_TEXT)),
    TRUE ~ NA_character_
  ))

# Base population is the full biomarker sample (76), not age_df -- age_df
# requires a valid DOB and session date (2 participants, both HR-available,
# lack one of those and would otherwise be silently dropped from every
# comparison here, not just the age one). age_at_session is left-joined so it
# is simply NA for those 2 (each t.test() drops NAs for that one comparison
# only, same as any t.test always does), rather than bottlenecking the
# puberty/BMI/gender checks by age-availability too. (biomarker_ids itself
# is computed earlier, in the biomarker-panels chunk, so static_covariates
# above can also be scoped to the full 76-person sample.)
hr_subsample_compare <- tibble(SampleID = biomarker_ids) |>
  left_join(age_df,   by = "SampleID") |>
  left_join(sos_puberty, by = "SampleID") |>
  left_join(bmi |> select(SampleID, BMI), by = "SampleID") |>
  left_join(gender |> select(SampleID, identity), by = "SampleID") |>
  mutate(has_hr = if_else(SampleID %in% hr_available_ids, "Has HR data", "No HR data"))

n_has_hr <- sum(hr_subsample_compare$has_hr == "Has HR data")
n_no_hr  <- sum(hr_subsample_compare$has_hr == "No HR data")

t_age_hr <- t.test(age_at_session ~ has_hr, data = hr_subsample_compare)
t_pub_hr <- t.test(PUBcomp        ~ has_hr, data = hr_subsample_compare)
t_bmi_hr <- t.test(BMI            ~ has_hr, data = hr_subsample_compare)

gender_hr_tbl    <- table(hr_subsample_compare$has_hr, hr_subsample_compare$identity)
chisq_gender_hr  <- suppressWarnings(chisq.test(gender_hr_tbl))
```

```{r hr-subsample-table}
# n is the group's total size (of the full 76-person biomarker sample); n
# per variable is reported separately since it can be smaller for age
# specifically (2 participants, both HR-available, lack a valid DOB/session
# date and so contribute to no age statistic, though they do to PUBcomp/BMI/
# gender).
hr_subsample_desc <- hr_subsample_compare |>
  group_by(has_hr) |>
  summarise(
    n           = n(),
    `Age: n (M, SD)`     = paste0(sum(!is.na(age_at_session)), " (", round(mean(age_at_session, na.rm = TRUE), 2), ", ", round(sd(age_at_session, na.rm = TRUE), 2), ")"),
    `PUBcomp: n (M, SD)` = paste0(sum(!is.na(PUBcomp)), " (", round(mean(PUBcomp, na.rm = TRUE), 2), ", ", round(sd(PUBcomp, na.rm = TRUE), 2), ")"),
    `BMI: n (M, SD)`     = paste0(sum(!is.na(BMI)), " (", round(mean(BMI, na.rm = TRUE), 2), ", ", round(sd(BMI, na.rm = TRUE), 2), ")"),
    .groups = "drop"
  )

hr_subsample_desc |>
  kable(col.names = c("Group", "n (total)", "Age: n (M, SD)", "PUBcomp: n (M, SD)", "BMI: n (M, SD)"),
        caption = "Descriptives: participants with vs. without usable HR data") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)

tibble(
  Variable = c("Age at session", "Pubertal status (PUBcomp)", "BMI", "Gender identity"),
  Test     = c("Welch t-test", "Welch t-test", "Welch t-test", "Chi-square"),
  Statistic = c(round(unname(t_age_hr$statistic), 3), round(unname(t_pub_hr$statistic), 3),
                round(unname(t_bmi_hr$statistic), 3), round(unname(chisq_gender_hr$statistic), 3)),
  df       = c(round(unname(t_age_hr$parameter), 1), round(unname(t_pub_hr$parameter), 1),
               round(unname(t_bmi_hr$parameter), 1), unname(chisq_gender_hr$parameter)),
  p        = c(round(t_age_hr$p.value, 4), round(t_pub_hr$p.value, 4),
               round(t_bmi_hr$p.value, 4), round(chisq_gender_hr$p.value, 4))
) |>
  mutate(p = cell_spec(p, bold = p < 0.05, color = if_else(p < 0.05, "#2166ac", "black"))) |>
  kable(escape = FALSE, caption = "Has-HR-data vs. no-HR-data: group comparisons (uncorrected -- 4 independent checks, not a multi-test family in the sense the rest of this document FDR-corrects)") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```

```{r hr-subsample-results-vals, echo=FALSE, include=FALSE}
hr_sig_checks <- c(
  if (t_age_hr$p.value < 0.05) "age" else NA,
  if (t_pub_hr$p.value < 0.05) "pubertal status" else NA,
  if (t_bmi_hr$p.value < 0.05) "BMI" else NA,
  if (chisq_gender_hr$p.value < 0.05) "gender identity" else NA
)
hr_sig_checks <- hr_sig_checks[!is.na(hr_sig_checks)]
hr_sig_text <- if (length(hr_sig_checks) == 0) "none of the four checks" else paste(hr_sig_checks, collapse = ", ")

n_missing_age_has_hr <- sum(hr_subsample_compare$has_hr == "Has HR data" & is.na(hr_subsample_compare$age_at_session))
n_missing_age_no_hr  <- sum(hr_subsample_compare$has_hr == "No HR data"  & is.na(hr_subsample_compare$age_at_session))
```




**Results.** Of the `r length(biomarker_ids)` participants with biomarker data, `r n_has_hr` also had usable HR data and `r n_no_hr` did not (`r n_has_hr` + `r n_no_hr` = `r n_has_hr + n_no_hr`, the full biomarker sample -- every HR-available participant has biomarker data, so this partition is exhaustive). Comparing the two groups on age, pubertal status, BMI, and gender identity, `r hr_sig_text` showed a significant difference at *p* < .05 (uncorrected). The age comparison specifically drops `r n_missing_age_has_hr + n_missing_age_no_hr` participant`r if (n_missing_age_has_hr + n_missing_age_no_hr != 1) "s"` (`r n_missing_age_has_hr` HR-available, `r n_missing_age_no_hr` not) who lack a valid DOB or session date and so have no computable age; they are retained for the pubertal status, BMI, and gender comparisons. `r if (length(hr_sig_checks) == 0) "This is consistent with HR-data availability being unrelated to these demographic/developmental characteristics, though this check cannot rule out selection on unmeasured variables (e.g., equipment/session-logistics reasons for missing HR data)." else "This difference should be considered when interpreting HR-based reactivity results or any comparison between HR and biomarker reactivity, since it suggests the two subsamples are not directly comparable on this measure."`

---

# Missing Data Summary

*Characterizes missingness across every variable used in the analyses above, against the full `r length(biomarker_ids)`-person biomarker analytic sample. This is descriptive -- it does not change any test -- but is meant to make visible, in one place, exactly how much (and where) each analysis's effective N is reduced from `r length(biomarker_ids)`, since several sensitivity checks above (the covariate-adjusted trend models especially) run on a substantially smaller sample than the primary analyses.*




```{r missingdata-setup, echo=FALSE}
flow_i_valid_ids <- flow_i_panel |> filter(!is.na(flow_rate)) |> distinct(SampleID) |> pull(SampleID)
flow_h_valid_ids <- flow_h_panel |> filter(!is.na(flow_rate)) |> distinct(SampleID) |> pull(SampleID)

missingdata_base <- tibble(SampleID = biomarker_ids) |>
  left_join(age_df       |> select(SampleID, age_at_session),                  by = "SampleID") |>
  left_join(bmi          |> select(SampleID, BMI),                             by = "SampleID") |>
  left_join(gender       |> select(SampleID, identity),                        by = "SampleID") |>
  left_join(sos_puberty  |> select(SampleID, PUBcomp),                         by = "SampleID") |>
  left_join(timing_df    |> select(SampleID, age_menarche_c, PDS_F5),          by = "SampleID") |>
  left_join(bfnes,                                                             by = "SampleID") |>
  left_join(dep,                                                               by = "SampleID") |>
  left_join(static_covariates |> select(SampleID, hours_since_wake),          by = "SampleID") |>
  mutate(
    flow_rate_immune  = if_else(SampleID %in% flow_i_valid_ids,  1, NA_real_),
    flow_rate_hormone = if_else(SampleID %in% flow_h_valid_ids,  1, NA_real_)
  )

missing_summary <- function(df, vars, labels) {
  n_total <- nrow(df)
  imap_dfr(setNames(vars, labels), function(v, lbl) {
    n_valid <- sum(!is.na(df[[v]]))
    tibble(Variable = lbl, `N total` = n_total, `N valid` = n_valid,
           `N missing` = n_total - n_valid,
           `% missing` = round(100 * (n_total - n_valid) / n_total, 1))
  })
}
```




## Demographic, Developmental, and Covariate Variables




```{r missingdata-demo}
demo_vars   <- c("age_at_session", "BMI", "identity", "PUBcomp", "age_menarche_c", "PDS_F5",
                 "BFNES_total", "CESD_total", "hours_since_wake", "flow_rate_immune", "flow_rate_hormone")
demo_labels <- c("Age at session", "BMI", "Gender identity", "Pubertal status (PUBcomp)",
                 "Age at menarche", "PDS F5 (perceived timing)", "BFNES (FNE)", "CES-DC (depressive symptoms)",
                 "Hours since waking", "Flow rate, immune tube (>=1 timepoint)", "Flow rate, hormone tube (>=1 timepoint)")

missing_summary(missingdata_base, demo_vars, demo_labels) |>
  kable(caption = paste0("Missing data: demographic, developmental, and covariate variables (of N = ", length(biomarker_ids), ")")) |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




*Hormone/cytokine-relevant medication use is not included above: it is coded FALSE (not missing) for anyone with no medication record, per the rationale in Section S2, so it has 0% missingness by construction rather than by data completeness.*

## The 13 Reactivity Indices




```{r missingdata-reactivity}
missing_summary(all_difference, reactivity_vars, reactivity_labels) |>
  kable(escape = FALSE,
        caption = paste0("Missing data: the 13 reactivity difference scores used throughout Aim 1d/2/3 (of N = ", length(biomarker_ids), ")")) |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




## Raw Biomarker Levels by Timepoint




```{r missingdata-levels}
bio_vars_named <- c(CRP_log = "CRP", IL10_log = "IL-10", IL6_log = "IL-6", TNFalpha_log = "TNF-alpha",
                     DHEA_log = "DHEA", Testosterone_log = "Testosterone", Cortisol_log = "Cortisol")

biomarker_levels |>
  group_by(Time) |>
  summarise(across(all_of(names(bio_vars_named)), \(x) sum(!is.na(x))), .groups = "drop") |>
  rename(!!!setNames(names(bio_vars_named), bio_vars_named)) |>
  mutate(Time = paste0("T", Time)) |>
  kable(caption = paste0("N with a valid (non-missing) reading, by biomarker and timepoint (of N = ", length(biomarker_ids), " each)")) |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```

```{r missingdata-results-vals, echo=FALSE, include=FALSE}
lowest_demo <- missing_summary(missingdata_base, demo_vars, demo_labels) |>
  slice_max(`% missing`, n = 1, with_ties = FALSE)
lowest_react <- missing_summary(all_difference, reactivity_vars, reactivity_labels) |>
  slice_max(`% missing`, n = 1, with_ties = FALSE)
```




**Results.** Among demographic/covariate variables, `r lowest_demo$Variable` has the most missingness (`r lowest_demo[["N missing"]]` of `r length(biomarker_ids)`, `r lowest_demo[["% missing"]]`%). Among the 13 reactivity indices, `r lowest_react$Variable` has the most missingness (`r lowest_react[["N missing"]]` of `r length(biomarker_ids)`, `r lowest_react[["% missing"]]`%). Raw biomarker-level missingness is generally low and fairly stable across timepoints (see table above); it is the *covariates* -- hours since waking and hormone-tube flow rate specifically -- that drive the much smaller analytic samples in the covariate-adjusted models in Section S2, not the biomarker measurements themselves. The hours-since-waking missingness in particular reflects a protocol change rather than differential non-response: the wake-time item was added to the session-runner questionnaire partway through data collection, so every session recorded before 2019-04-14 has no wake time on file (regardless of participant), while sessions from 2019-04-14 onward have it recorded essentially universally.

---

# Sensitivity Analyses

*Full sensitivity and robustness analyses supporting the Aim 1–3 results in
`sos-bioreactivity-analyses.qmd`. Section 3a (Exclusionary) re-runs the primary analyses after
excluding participants for illness, bleeding gums, or smoking. Section 3b (Adjusted) re-fits the
primary models with physiological covariates entered directly. The Cross-Check subsection ties
both sets of results together against the primary (unadjusted, full-sample) findings.*

## S1: Exclusionary

*Participants flagged here (illness, bleeding gums, smoking) are excluded in the analyses below.*

### Covariate Descriptives

#### Smokers




```{r cov-smoking-desc}
smoking |>
  count(smokes) |>
  mutate(smokes = if_else(smokes, "Yes", "No")) |>
  kable(col.names = c("Smokes", "n"),
        caption   = "Smoking status at time of session") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




#### Oral Hygiene




```{r cov-oral-health-desc}
oral_health |>
  summarise(
    `N participants`          = as.character(n()),
    `Gum soreness: mean (SD)` = paste0(
      round(mean(gum_soreness, na.rm = TRUE), 1), " (",
      round(sd(gum_soreness,   na.rm = TRUE), 1), ")"
    ),
    `Bleeding gums: n (%)`    = paste0(
      sum(bleeding_gums, na.rm = TRUE), " (",
      round(mean(bleeding_gums, na.rm = TRUE) * 100, 1), "%)"
    )
  ) |>
  pivot_longer(everything(), names_to = "Item", values_to = "Value") |>
  kable(caption = "Oral health descriptives") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




#### Illness




```{r cov-illness-n}
illness |>
  count(ill_yn) |>
  mutate(ill_yn = if_else(ill_yn, "Yes", "No")) |>
  kable(col.names = c("Ill in last 24 hrs", "n"),
        caption   = "Illness at time of session") |>
