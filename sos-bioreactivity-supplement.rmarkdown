### Illness Exclusion

Re-running peak vs. T1 t-tests and HR t-tests after excluding participants who were ill at the time of the session.




```{r sens-illness-exclusion, echo=FALSE}
crp_wide_well      <- sos_crp_wide      |> filter(!SampleID %in% ill_ids)
cytokines_wide_well <- sos_cytokines_wide |> filter(!SampleID %in% ill_ids)
hormones_wide_well  <- sos_hormones_wide  |> filter(!SampleID %in% ill_ids)
hr_all_wide_well    <- hr_all_wide        |>
  mutate(SampleID = str_sub(id, 1, 6)) |>
  filter(!SampleID %in% ill_ids)
hr_conditions_well  <- hr_conditions_avg  |>
  mutate(SampleID = case_when(
    str_sub(id, 1, 6) == "SOS068" ~ "TAG068",
    str_sub(id, 1, 6) == "SOS076" ~ "TAG076",
    .default = str_sub(id, 1, 6)
  )) |>
  filter(!SampleID %in% ill_ids)
pull_hr_well <- function(cond) filter(hr_conditions_well, task_condition == cond)$mean_hr
```

```{r sens-illness-biomarker-ttests}
sens_peak_tests <- list(
  crp  = run_peak_test("crp_peak",  "CRP_log_1",          crp_wide_well),
  il10 = run_peak_test("il10_peak", "IL10_log_1",         cytokines_wide_well),
  il6  = run_peak_test("il6_peak",  "IL6_log_1",          cytokines_wide_well),
  tnfa = run_peak_test("tnfa_peak", "TNFalpha_log_1",     cytokines_wide_well),
  dhea = run_peak_test("dhea_peak", "DHEA_log_1",         hormones_wide_well),
  test = run_peak_test("test_peak", "Testosterone_log_1", hormones_wide_well),
  cort = run_peak_test("cort_peak", "Cortisol_log_1",     hormones_wide_well)
)

sens_pfdr <- setNames(
  c(p.adjust(map_dbl(sens_peak_tests[1:4], \(t) t$p.value), method = "fdr"),
    p.adjust(map_dbl(sens_peak_tests[5:7], \(t) t$p.value), method = "fdr")),
  names(sens_peak_tests)
)

sens_peak_tests |>
  map(broom::tidy) |>
  list_rbind(names_to = "biomarker") |>
  mutate(
    biomarker = case_match(biomarker,
      "crp" ~ "CRP", "il10" ~ "IL-10", "il6" ~ "IL-6", "tnfa" ~ "TNF-α",
      "dhea" ~ "DHEA", "test" ~ "Testosterone", "cort" ~ "Cortisol"
    ),
    p_fdr = round(unname(sens_pfdr), 4)
  ) |>
  select(biomarker, estimate, statistic, parameter, p.value, p_fdr) |>
  mutate(across(where(is.numeric), \(x) round(x, 3))) |>
  mutate(p_fdr = cell_spec(p_fdr, bold = p_fdr < 0.05,
    color = if_else(p_fdr < 0.05, "#2166ac", "black"))) |>
  kable(col.names = c("biomarker", "Mean diff", "t", "df", "p (raw)", "p (FDR)"),
        escape = FALSE,
        caption = "Peak vs. T1 t-tests excluding ill participants") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```

```{r sens-illness-hr-ttests}
list(
  "Task vs. Resting"                     = t.test(hr_all_wide_well$Task, hr_all_wide_well$resting_avg, alternative = "two.sided", paired = TRUE),
  "Self-Connected vs. Fixation-Cross"    = t.test(pull_hr_well("Self-Connected"), pull_hr_well("Fixation-Cross"),    alternative = "two.sided", paired = TRUE),
  "Self-Connected vs. Self-Disconnected" = t.test(pull_hr_well("Self-Connected"), pull_hr_well("Self-Disconnected"), alternative = "two.sided", paired = TRUE),
  "Self-Connected vs. Other"             = t.test(pull_hr_well("Self-Connected"), pull_hr_well("Other"),            alternative = "two.sided", paired = TRUE)
) |>
  map(broom::tidy) |>
  list_rbind(names_to = "comparison") |>
  select(comparison, estimate, statistic, parameter, p.value) |>
  mutate(across(where(is.numeric), \(x) round(x, 3))) |>
  mutate(p.value = cell_spec(p.value, bold = p.value < 0.05,
    color = if_else(p.value < 0.05, "#2166ac", "black"))) |>
  kable(col.names = c("Comparison", "Mean diff", "t", "df", "p"),
        escape = FALSE,
        caption = "HR paired t-tests excluding ill participants") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




### BMI × Biomarker Reactivity (Illness-Excluded)

For each biomarker reactivity score (peak − T1), we correlated BMI with the difference score in the illness-excluded sample, matching the bivariate-correlation approach used for the other covariate checks in this document.




```{r sens-cov-processing, echo=FALSE}
cov_immune <- biomarkers_difference |>
  left_join(bmi         |> select(SampleID, BMI),                        by = "SampleID") |>
  left_join(oral_health |> select(SampleID, bleeding_gums, gum_soreness), by = "SampleID") |>
  left_join(illness     |> select(SampleID, ill_yn),                     by = "SampleID") |>
  filter(!ill_yn | is.na(ill_yn))

cov_hormones <- hormones_difference |>
  left_join(bmi     |> select(SampleID, BMI),    by = "SampleID") |>
  left_join(illness |> select(SampleID, ill_yn), by = "SampleID") |>
  filter(!ill_yn | is.na(ill_yn))
```

```{r sens-cov-bmi-corr}
immune_outcomes  <- c("crp_difference", "il10_difference", "il6_difference", "tnfa_difference")
immune_labels    <- c("ΔCRP", "ΔIL-10", "ΔIL-6", "ΔTNF-α")
hormone_outcomes <- c("dhea_difference", "test_difference", "cort_difference")
hormone_labels   <- c("ΔDHEA", "ΔTestosterone", "ΔCortisol")

run_bmi_corr <- function(outcome, data) {
  dat <- data |> select(all_of(outcome), BMI) |> na.omit()
  cor.test(dat[[outcome]], dat$BMI)
}

immune_bmi_fits  <- map(immune_outcomes,  \(o) run_bmi_corr(o, cov_immune))  |> setNames(immune_labels)
hormone_bmi_fits <- map(hormone_outcomes, \(o) run_bmi_corr(o, cov_hormones)) |> setNames(hormone_labels)

immune_bmi_praw  <- map_dbl(immune_bmi_fits,  \(ct) ct$p.value)
hormone_bmi_praw <- map_dbl(hormone_bmi_fits, \(ct) ct$p.value)
immune_bmi_pfdr  <- setNames(p.adjust(immune_bmi_praw,  method = "fdr"), names(immune_bmi_praw))
hormone_bmi_pfdr <- setNames(p.adjust(hormone_bmi_praw, method = "fdr"), names(hormone_bmi_praw))

bind_rows(
  tibble(Biomarker = immune_labels,
         r     = map_dbl(immune_bmi_fits, \(ct) unname(ct$estimate)),
         p_raw = unname(immune_bmi_praw),
         p_fdr = unname(immune_bmi_pfdr)),
  tibble(Biomarker = hormone_labels,
         r     = map_dbl(hormone_bmi_fits, \(ct) unname(ct$estimate)),
         p_raw = unname(hormone_bmi_praw),
         p_fdr = unname(hormone_bmi_pfdr))
) |>
  mutate(across(c(r, p_raw, p_fdr), \(x) round(x, 3))) |>
  mutate(p_fdr = cell_spec(p_fdr, bold = p_fdr < 0.05,
    color = if_else(p_fdr < 0.05, "#2166ac", "black"))) |>
  kable(escape = FALSE,
        col.names = c("Biomarker", "r", "p (raw)", "p (FDR)"),
        caption = "BMI x biomarker reactivity correlations, illness-excluded (FDR within immune markers / hormones)") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




### Bleeding Gums & Smoking Exclusion

Re-running peak vs. T1 biomarker t-tests after excluding participants who reported bleeding gums OR who smoke, in addition to those who were ill.




```{r sens-bleed-smoke-exclusion, echo=FALSE}
excl_clean_ids <- illness    |> filter(ill_yn) |> pull(SampleID) |>
  union(oral_health |> filter(bleeding_gums == 1) |> pull(SampleID)) |>
  union(smoking     |> filter(smokes)             |> pull(SampleID))

cat("N excluded (ill + bleeding + smoking):", length(excl_clean_ids), "\n")
cat("IDs:", paste(sort(excl_clean_ids), collapse = ", "), "\n")

crp_wide_clean       <- sos_crp_wide       |> filter(!SampleID %in% excl_clean_ids)
cytokines_wide_clean <- sos_cytokines_wide |> filter(!SampleID %in% excl_clean_ids)
hormones_wide_clean  <- sos_hormones_wide  |> filter(!SampleID %in% excl_clean_ids)
```

```{r sens-bleed-smoke-ttests}
clean_peak_tests <- list(
  crp  = run_peak_test("crp_peak",  "CRP_log_1",          crp_wide_clean),
  il10 = run_peak_test("il10_peak", "IL10_log_1",         cytokines_wide_clean),
  il6  = run_peak_test("il6_peak",  "IL6_log_1",          cytokines_wide_clean),
  tnfa = run_peak_test("tnfa_peak", "TNFalpha_log_1",     cytokines_wide_clean),
  dhea = run_peak_test("dhea_peak", "DHEA_log_1",         hormones_wide_clean),
  test = run_peak_test("test_peak", "Testosterone_log_1", hormones_wide_clean),
  cort = run_peak_test("cort_peak", "Cortisol_log_1",     hormones_wide_clean)
)

clean_pfdr <- setNames(
  c(p.adjust(map_dbl(clean_peak_tests[1:4], \(t) t$p.value), method = "fdr"),
    p.adjust(map_dbl(clean_peak_tests[5:7], \(t) t$p.value), method = "fdr")),
  names(clean_peak_tests)
)

clean_peak_tests |>
  map(broom::tidy) |>
  list_rbind(names_to = "biomarker") |>
  mutate(
    biomarker = case_match(biomarker,
      "crp"  ~ "CRP",    "il10" ~ "IL-10", "il6"  ~ "IL-6", "tnfa" ~ "TNF-α",
      "dhea" ~ "DHEA",   "test" ~ "Testosterone",            "cort" ~ "Cortisol"
    ),
    p_fdr = round(unname(clean_pfdr), 4)
  ) |>
  select(biomarker, estimate, statistic, parameter, p.value, p_fdr) |>
  mutate(across(where(is.numeric), \(x) round(x, 3))) |>
  mutate(p_fdr = cell_spec(p_fdr, bold = p_fdr < 0.05,
    color = if_else(p_fdr < 0.05, "#2166ac", "black"))) |>
  kable(col.names = c("biomarker", "Mean diff", "t", "df", "p (raw)", "p (FDR)"),
        escape = FALSE,
        caption = "Peak vs. T1 t-tests: excluding ill, bleeding gums, and smokers") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




### Biomarker Trends: Illness, Bleeding Gums & Smoking Exclusion

Re-fitting the immune biomarker time-trend models (CRP, IL-10, IL-6, TNF-α) after excluding participants who were ill, reported bleeding gums, or smoke. Hormones are not re-run here since illness/bleeding gums/smoking are inflammation-specific confounds.




```{r sens-trend-clean-processing, echo=FALSE}
crp_panel_clean       <- sos_crp_panel       |> filter(!SampleID %in% excl_clean_ids)
cytokines_panel_clean <- sos_cytokines_panel |> filter(!SampleID %in% excl_clean_ids)

mlm_clean_crp      <- run_mlm("CRP_log",      crp_panel_clean)
mlm_clean_il10     <- run_mlm("IL10_log",     cytokines_panel_clean)
mlm_clean_il6      <- run_mlm("IL6_log",      cytokines_panel_clean)
mlm_clean_tnfalpha <- run_mlm("TNFalpha_log", cytokines_panel_clean)

mlm_clean_list <- list(
  "CRP" = mlm_clean_crp, "IL-10" = mlm_clean_il10, "IL-6" = mlm_clean_il6, "TNF-alpha" = mlm_clean_tnfalpha
)
```

```{r sens-trend-clean-comparison}
clean_model_comp_tbl <- imap_dfr(mlm_clean_list, function(res, name) {
  tibble(
    biomarker = name,
    Model   = c("Linear", "Quadratic"),
    df      = res$aic$df,
    AIC     = round(res$aic$AIC, 1),
    BIC     = round(res$bic$BIC, 1)
  )
})

clean_best_rows <- clean_model_comp_tbl |>
  group_by(biomarker) |>
  mutate(is_best = AIC == min(AIC)) |>
  ungroup() |>
  pull(is_best)

clean_model_comp_tbl |>
  kable(caption = "Model comparison: excluding ill, bleeding gums, and smokers") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE) |>
  row_spec(which(clean_best_rows), bold = TRUE, color = "#2166ac")
```

```{r sens-trend-clean-fixed-effects, results='asis'}
clean_fixed_effects <- imap_dfr(mlm_clean_list, function(res, name) {
  broom.mixed::tidy(res$quadratic, effects = "fixed") |>
    mutate(biomarker = name)
}) |>
  group_by(term) |>
  mutate(p_fdr = p.adjust(p.value, method = "fdr")) |>
  ungroup()

iwalk(mlm_clean_list, function(res, name) {
  cat("\n\n####", name, "\n\n")
  tbl <- clean_fixed_effects |>
    filter(biomarker == name) |>
    select(term, estimate, std.error, statistic, df, p.value, p_fdr) |>
    mutate(
      across(c(estimate, std.error, statistic, df), \(x) round(x, 3)),
      p.value = round(p.value, 4),
      p_fdr   = round(p_fdr,   4)
    )
  tbl |>
    mutate(p_fdr = cell_spec(p_fdr, bold = !is.na(p_fdr) & p_fdr < 0.05,
      color = if_else(!is.na(p_fdr) & p_fdr < 0.05, "#2166ac", "black"))) |>
    kable(escape = FALSE,
          col.names = c("Term", "b", "SE", "t", "df", "p (raw)", "p (FDR)"),
          caption = paste(name, "quadratic fixed effects (excluding ill, bleeding gums, smokers)")) |>
    kable_styling(bootstrap_options = "hover", full_width = FALSE) |>
    print()
})
```




### Reactivity Correlations: Illness, Bleeding Gums & Smoking Exclusion

Correlations between each of the 4 immune reactivity measures and all 13 reactivity measures (Aim 1d), recomputed after excluding participants who were ill, reported bleeding gums, or smoke.




```{r sens-corr-clean, fig.width=12, fig.height=4}
diff_matrix_clean <- all_difference |>
  filter(!SampleID %in% excl_clean_ids) |>
  select(-SampleID) |>
  as.matrix()
colnames(diff_matrix_clean) <- c(
  "ΔHR: Task vs. Rest", "ΔHR: SC vs. SD", "ΔHR: SC vs. Other", "ΔHR: SC vs. Fixation-Cross",
  "ΔCRP", "ΔIL-10", "ΔIL-6", "ΔTNF-α", "ΔDHEA", "ΔTestosterone", "ΔCortisol",
  "ΔSubj Stress: SC vs. SD", "ΔSubj Stress: SC vs. Other"
)

diff_rcorrs_clean <- rcorr(diff_matrix_clean)

immune_labels_clean   <- c("ΔCRP", "ΔIL-10", "ΔIL-6", "ΔTNF-α")
all_reactivity_labels <- colnames(diff_matrix_clean)

hr_cols_clean   <- all_reactivity_labels[1:4]
imm_cols_clean  <- all_reactivity_labels[5:8]
horm_cols_clean <- all_reactivity_labels[9:11]
subj_cols_clean <- all_reactivity_labels[12:13]

raw_immune_clean_mat <- diff_rcorrs_clean$P[immune_labels_clean, all_reactivity_labels, drop = FALSE]
fdr_immune_clean_mat <- raw_immune_clean_mat
for (im in immune_labels_clean) {
  for (cols in list(hr_cols_clean, imm_cols_clean, horm_cols_clean, subj_cols_clean)) {
    fdr_immune_clean_mat[im, cols] <- p.adjust(raw_immune_clean_mat[im, cols], method = "fdr")
  }
}

# The 4 immune measures appear both as rows and as part of the 13 columns, so
# this matrix contains true self-correlations (e.g. ΔCRP row x ΔCRP column:
# r = 1, p = NA from rcorr). corrplot cannot handle r non-NA / p NA at the
# same cell, so those self-correlation cells are blanked in r too.
r_immune_clean_mat <- diff_rcorrs_clean$r[immune_labels_clean, all_reactivity_labels, drop = FALSE]
self_pairs <- outer(immune_labels_clean, all_reactivity_labels, `==`)
r_immune_clean_mat[self_pairs] <- NA

plot_sig_corrplot(
  r_immune_clean_mat,
  fdr_immune_clean_mat,
  type = "full", cl.ratio = 0.1, cl.cex = 1.1,
  tl.cex = 0.98, mar = c(0, 0, 1, 5), diag = TRUE
)
```




*X marks indicate non-significant correlations after FDR correction (p~FDR~ ≥ .05). FDR applied separately for each immune reactivity measure, within each reactivity domain (matches the Aim 1d FDR convention).*




```{r sens-corr-clean-tables}
# The corrplot above has no numeric table alongside it (unlike the full-sample
# version of this matrix); adding one here, same convention as elsewhere in
# this document.
r_immune_clean_mat |>
  as.data.frame() |>
  mutate(across(everything(), \(x) if_else(is.na(x), "—", as.character(round(x, 3))))) |>
  kable(caption = "Pearson r: illness/bleeding-gums/smoking-excluded sample, immune reactivity x all 13 reactivity outcomes") |>
  kable_styling(bootstrap_options = "hover")

fdr_immune_clean_mat |>
  as.data.frame() |>
  mutate(across(everything(), \(x) {
    sig  <- !is.na(x) & x < 0.05
    xlab <- if_else(is.na(x), "—", as.character(round(x, 4)))
    cell_spec(xlab, bold = sig, color = if_else(sig, "#2166ac", "black"))
  })) |>
  kable(escape = FALSE,
        caption = "FDR-adjusted p-values: illness/bleeding-gums/smoking-excluded sample, immune reactivity x all 13 reactivity outcomes (bold = p_FDR < .05)") |>
  kable_styling(bootstrap_options = "hover")
```




### Puberty Correlations: Illness, Bleeding Gums & Smoking Exclusion

Correlations between pubertal status/timing (Aim 2) and the 4 immune reactivity measures, recomputed after excluding participants who were ill, reported bleeding gums, or smoke.




```{r sens-puberty-corr-clean, fig.width=8, fig.height=4}
timing_reactivity_clean <- timing_reactivity |>
  filter(!SampleID %in% excl_clean_ids)

immune_reactivity_vars   <- c("crp_difference", "il10_difference", "il6_difference", "tnfa_difference")
immune_reactivity_labels <- c("ΔCRP", "ΔIL-10", "ΔIL-6", "ΔTNF-α")

pub_immune_mat_clean <- timing_reactivity_clean |>
  select(all_of(c(all_pub_vars, immune_reactivity_vars))) |>
  as.matrix()
colnames(pub_immune_mat_clean) <- c(all_pub_labels, immune_reactivity_labels)

pub_immune_corrs_clean <- rcorr(pub_immune_mat_clean)

raw_pub_immune_clean <- pub_immune_corrs_clean$P[all_pub_labels, immune_reactivity_labels, drop = FALSE]
fdr_pub_immune_clean <- raw_pub_immune_clean
for (pv in all_pub_labels) {
  fdr_pub_immune_clean[pv, ] <- p.adjust(raw_pub_immune_clean[pv, ], method = "fdr")
}

plot_sig_corrplot(
  pub_immune_corrs_clean$r[all_pub_labels, immune_reactivity_labels, drop = FALSE],
  fdr_pub_immune_clean,
  type = "full", cl.ratio = 0.15, cl.cex = 1.1,
  tl.cex = 1.0, mar = c(0, 0, 1, 4), diag = TRUE
)
```




*X marks indicate non-significant correlations after FDR correction (p~FDR~ ≥ .05). FDR applied separately for each puberty/timing variable, across the 4 immune reactivity outcomes.*




```{r sens-puberty-corr-clean-tables}
# Same gap as the immune-reactivity corrplot above -- no numeric table
# alongside it; adding one here.
pub_immune_corrs_clean$r[all_pub_labels, immune_reactivity_labels, drop = FALSE] |>
  as.data.frame() |>
  mutate(across(everything(), \(x) if_else(is.na(x), "—", as.character(round(x, 3))))) |>
  kable(caption = "Pearson r: illness/bleeding-gums/smoking-excluded sample, pubertal status/timing x immune reactivity") |>
  kable_styling(bootstrap_options = "hover")

fdr_pub_immune_clean |>
  as.data.frame() |>
  mutate(across(everything(), \(x) {
    sig  <- !is.na(x) & x < 0.05
    xlab <- if_else(is.na(x), "—", as.character(round(x, 4)))
    cell_spec(xlab, bold = sig, color = if_else(sig, "#2166ac", "black"))
  })) |>
  kable(escape = FALSE,
        caption = "FDR-adjusted p-values: illness/bleeding-gums/smoking-excluded sample, pubertal status/timing x immune reactivity (bold = p_FDR < .05)") |>
  kable_styling(bootstrap_options = "hover")
```




## S2: Covariate-Adjusted

*Age, BMI, hours since waking, and (for CRP, DHEA, and Testosterone) flow rate are entered as
covariates in the models below.*

### Covariate Descriptives

#### Sample Timing

`i` = immune-tube collection (paired with CRP/cytokine reactivity); `h` = hormone-tube
collection (paired with hormone reactivity). The two are collected within the same minute for
nearly everyone, so only modest differences are expected between them.




```{r cov-sample-timing-desc}
saliva_timing |>
  select(starts_with("elapsed_")) |>
  summarise(across(everything(), list(
    Mean = \(x) round(mean(x, na.rm = TRUE), 1),
    SD   = \(x) round(sd(x,   na.rm = TRUE), 1),
    Min  = \(x) round(min(x,  na.rm = TRUE), 1),
    Max  = \(x) round(max(x,  na.rm = TRUE), 1),
    N    = \(x) sum(!is.na(x))
  ))) |>
  pivot_longer(everything(), names_to = c("variable", "stat"), names_sep = "_(?=[^_]+$)") |>
  pivot_wider(names_from = stat, values_from = value) |>
  mutate(variable = recode(variable,
    elapsed_i_T2 = "T1 → T2 (immune tube)",
    elapsed_i_T3 = "T1 → T3 (immune tube)",
    elapsed_i_T4 = "T1 → T4 (immune tube)",
    elapsed_h_T2 = "T1 → T2 (hormone tube)",
    elapsed_h_T3 = "T1 → T3 (hormone tube)",
    elapsed_h_T4 = "T1 → T4 (hormone tube)"
  )) |>
  kable(caption = "Actual elapsed time (minutes) between saliva collections") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




#### Flow Rate

Saliva flow rate (mL/min) at each timepoint, by tube type.




```{r cov-flow-rate-desc}
session_flow_raw |>
  select(starts_with("flow_")) |>
  summarise(across(everything(), list(
    Mean = \(x) round(mean(x, na.rm = TRUE), 2),
    SD   = \(x) round(sd(x,   na.rm = TRUE), 2),
    Min  = \(x) round(min(x,  na.rm = TRUE), 2),
    Max  = \(x) round(max(x,  na.rm = TRUE), 2),
    N    = \(x) sum(!is.na(x))
  ))) |>
  pivot_longer(everything(), names_to = c("variable", "stat"), names_sep = "_(?=[^_]+$)") |>
  pivot_wider(names_from = stat, values_from = value) |>
  mutate(
    tube = if_else(str_detect(variable, "flow_i_"), "Immune tube", "Hormone tube"),
    Time = paste0("T", str_extract(variable, "\\d$"))
  ) |>
  select(tube, Time, Mean, SD, Min, Max, N) |>
  arrange(tube, Time) |>
  kable(caption = "Saliva flow rate (mL/min) by timepoint and tube type") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




#### BMI




```{r cov-bmi-desc}
bmi |>
  summarise(
    n    = sum(!is.na(BMI)),
    Mean = round(mean(BMI, na.rm = TRUE), 2),
    SD   = round(sd(BMI,   na.rm = TRUE), 2),
    Min  = round(min(BMI,  na.rm = TRUE), 2),
    Max  = round(max(BMI,  na.rm = TRUE), 2)
  ) |>
  kable(caption = "BMI descriptives") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




#### Age




```{r cov-age-desc}
age_df |>
  summarise(
    n    = sum(!is.na(age_at_session)),
    Mean = round(mean(age_at_session, na.rm = TRUE), 2),
    SD   = round(sd(age_at_session,   na.rm = TRUE), 2),
    Min  = round(min(age_at_session,  na.rm = TRUE), 2),
    Max  = round(max(age_at_session,  na.rm = TRUE), 2)
  ) |>
  kable(caption = "Age at session (years)") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




#### Time Since Waking

Wake time was recorded as free text; times after 12:00 pm were treated as implausible and set
to missing. Elapsed hours = time of T1 (immune tube) collection minus wake time.




```{r cov-wake-desc}
wake_time |>
  filter(!is.na(hours_since_wake)) |>
  summarise(
    n    = n(),
    Mean = round(mean(hours_since_wake), 1),
    SD   = round(sd(hours_since_wake), 1),
    Min  = round(min(hours_since_wake), 1),
    Max  = round(max(hours_since_wake), 1)
  ) |>
  kable(caption = "Hours elapsed from waking to T1 sample collection") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




### Flow Rate, Age, BMI & Time-Since-Waking vs. Reactivity




```{r covflow-processing, echo=FALSE}
# Flow-rate difference: peak-timepoint flow rate minus T1 flow rate, matched
# to each biomarker's own peak-timepoint selection (T3 or T4) — mirrors how
# the biomarker reactivity difference scores themselves are computed.
# Only computed for CRP, DHEA, and Testosterone, since these are the only
# biomarkers whose concentrations are expected to depend on saliva volume
# per unit time. 'i' (immune-tube) flow is used for CRP; 'h' (hormone-tube)
# flow is used for DHEA/Testosterone.
flow_reactivity <- sos_crp_wide |>
  select(SampleID, CRP_log_1, CRP_log_3, CRP_log_4) |>
  full_join(
    sos_hormones_wide |>
      select(SampleID, DHEA_log_1, DHEA_log_3, DHEA_log_4,
             Testosterone_log_1, Testosterone_log_3, Testosterone_log_4),
    by = "SampleID"
  ) |>
  left_join(session_flow_raw, by = "SampleID") |>
  mutate(
    crp_peak_tp  = if_else(CRP_log_3 > CRP_log_4, 3, 4),
    dhea_peak_tp = if_else(DHEA_log_3 > DHEA_log_4, 3, 4),
    test_peak_tp = if_else(Testosterone_log_3 > Testosterone_log_4, 3, 4),

    crp_flow_diff  = if_else(crp_peak_tp  == 3, flow_i_3, flow_i_4) - flow_i_1,
    dhea_flow_diff = if_else(dhea_peak_tp == 3, flow_h_3, flow_h_4) - flow_h_1,
    test_flow_diff = if_else(test_peak_tp == 3, flow_h_3, flow_h_4) - flow_h_1
  ) |>
  select(SampleID, crp_flow_diff, dhea_flow_diff, test_flow_diff)

covflow_react_join <- all_difference |>
  left_join(flow_reactivity,    by = "SampleID") |>
  left_join(static_covariates,  by = "SampleID")

covflow_vars   <- c("crp_flow_diff", "dhea_flow_diff", "test_flow_diff",
                    "age_at_session", "BMI", "hours_since_wake")
covflow_labels <- c("Flow Rate Δ: CRP sample", "Flow Rate Δ: DHEA sample", "Flow Rate Δ: Testosterone sample",
                    "Age at session (years)", "BMI", "Hours since waking")

flow_covflow_labels <- covflow_labels[1:3]
```




#### Descriptives




```{r covflow-descriptives}
covflow_react_join |>
  select(all_of(covflow_vars)) |>
  summarise(across(everything(), list(
    Mean = \(x) round(mean(x, na.rm = TRUE), 2),
    SD   = \(x) round(sd(x,   na.rm = TRUE), 2),
    Min  = \(x) round(min(x,  na.rm = TRUE), 2),
    Max  = \(x) round(max(x,  na.rm = TRUE), 2),
    N    = \(x) sum(!is.na(x))
  ))) |>
  pivot_longer(everything(), names_to = c("variable", "stat"), names_sep = "_(?=[^_]+$)") |>
  pivot_wider(names_from = stat, values_from = value) |>
  mutate(variable = recode(variable, !!!setNames(covflow_labels, covflow_vars))) |>
  kable(caption = "Physiological covariate descriptives (flow-rate deltas in mL/min; peak timepoint minus T1)") |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```




#### Correlations: Physiological Covariates × All 13 Reactivity Outcomes

This uses the same bivariate-correlation approach as the primary reactivity-correlation analyses (Aim 1d, Aim 2). Columns are the same 13 reactivity outcomes used throughout (4 HR, 4 immune, 3 hormone, 2 subjective stress).




```{r covflow-corr-matrix, fig.width=14, fig.height=6}
covflow_mat <- covflow_react_join |>
  select(all_of(c(covflow_vars, reactivity_vars))) |>
  as.matrix()
colnames(covflow_mat) <- c(covflow_labels, reactivity_labels)

covflow_corrs <- rcorr(covflow_mat)

raw_covflow_mat <- covflow_corrs$P[covflow_labels, reactivity_labels, drop = FALSE]
fdr_covflow_mat <- raw_covflow_mat
for (cv in covflow_labels) {
  for (cols in list(hr_cols, imm_cols, horm_cols, subj_cols)) {
    fdr_covflow_mat[cv, cols] <- p.adjust(raw_covflow_mat[cv, cols], method = "fdr")
  }
}

r_covflow_mat <- covflow_corrs$r[covflow_labels, reactivity_labels, drop = FALSE]

# Mask flow-rate-difference rows against HR / subjective-stress columns
# (not a matched pairing; see note above). r and p must be blanked together
# — corrplot cannot handle a non-NA r paired with an NA p in the same cell.
r_covflow_mat[flow_covflow_labels, c(hr_cols, subj_cols)]   <- NA
fdr_covflow_mat[flow_covflow_labels, c(hr_cols, subj_cols)] <- NA

plot_sig_corrplot(
  r_covflow_mat,
  fdr_covflow_mat,
  type = "full", cl.ratio = 0.06, cl.cex = 1.1,
  tl.cex = 0.95, mar = c(0, 0, 1, 6), diag = TRUE
)
```




*X marks indicate non-significant correlations after FDR correction (p~FDR~ ≥ .05). FDR applied separately for each covariate, within each reactivity domain (HR, immune, hormones, subjective stress). Blank cells for the flow-rate-difference rows against HR/subjective-stress columns indicate the pairing was not tested (see note above).*

#### Correlation p-values: Physiological Covariates × All 13 Reactivity Outcomes




```{r covflow-corr-pvalues}
fdr_covflow_mat |>
  as.data.frame() |>
  mutate(across(everything(), \(x) {
    sig  <- !is.na(x) & x < 0.05
    xlab <- if_else(is.na(x), "—", as.character(round(x, 4)))
    cell_spec(xlab, bold = sig, color = if_else(sig, "#2166ac", "black"))
  })) |>
  kable(escape = FALSE,
        caption = "FDR-adjusted p-values: physiological covariates × all reactivity outcomes (bold = p_FDR < .05; — = not tested)") |>
  kable_styling(bootstrap_options = "hover")
```

```{r covflow-results-vals, echo=FALSE, include=FALSE}
sig_covflow <- expand.grid(cv = covflow_labels, rv = reactivity_labels, stringsAsFactors = FALSE) |>
  rowwise() |>
  mutate(
    r     = round(r_covflow_mat[cv, rv], 3),
    p_fdr = round(fdr_covflow_mat[cv, rv], 4),
    sig   = !is.na(p_fdr) & p_fdr < 0.05,
    label = paste0(cv, " × ", rv, " (r = ", r, ", p~FDR~ = ", p_fdr, ")")
  ) |>
  ungroup() |>
  filter(sig)

n_covflow_pairs_total <- sum(!is.na(fdr_covflow_mat))
n_sig_covflow         <- nrow(sig_covflow)
sig_covflow_text      <- if (n_sig_covflow == 0) "none survived FDR correction" else
  paste(sig_covflow$label, collapse = "; ")
```




**Results.** Across the `r n_covflow_pairs_total` physiological-covariate × reactivity-outcome pairs tested (flow-rate difference for CRP, DHEA, and Testosterone — the biomarkers expected to depend on saliva volume per unit time — each against all 7 biomarker reactivity outcomes; age, BMI, and hours since waking against all 13 reactivity outcomes; FDR-corrected separately for each covariate within each reactivity domain), `r n_sig_covflow` association`r if (n_sig_covflow != 1) "s" else ""` remained significant after correction: `r sig_covflow_text`.

### Covariate-Adjusted Biomarker Trends

*Each biomarker's time trend is re-fit with age, BMI, and hours since waking entered as fixed-effect covariates. Flow rate (time-varying, matched to the sample's own timepoint) is included only for CRP, DHEA, and Testosterone, since these are the biomarkers whose concentrations are expected to depend on saliva volume per unit time.*




```{r covtrend-processing, echo=FALSE}
# Flow rate enters as a time-varying (level-1) covariate, matched to each
# panel row's own Time via the long-format flow_i_panel / flow_h_panel built
# in the covariate-load chunk. Age, BMI, and hours since waking are
# person-level (level-2) covariates from static_covariates.
crp_panel_cov <- sos_crp_panel |>
  left_join(flow_i_panel,      by = c("SampleID", "Time")) |>
  left_join(static_covariates, by = "SampleID")

cytokines_panel_cov <- sos_cytokines_panel |>
  left_join(flow_i_panel,      by = c("SampleID", "Time")) |>
  left_join(static_covariates, by = "SampleID")

hormones_panel_cov <- sos_hormones_panel |>
  left_join(flow_h_panel,      by = c("SampleID", "Time")) |>
  left_join(static_covariates, by = "SampleID")

run_mlm_cov <- function(outcome, data, quadratic = TRUE, include_flow = TRUE) {
  time_term <- if (quadratic) "poly(Time, 2)" else "Time"
  flow_term <- if (include_flow) "flow_rate + " else ""
  f <- as.formula(paste(
    outcome,
    paste0("~ 1 + ", time_term, " + ", flow_term,
           "age_at_session + BMI + hours_since_wake + med_hormone_cytokine + (1 + ",
           time_term, " | SampleID)")
  ))
  fit <- lmer(f, data = data, na.action = na.omit, REML = TRUE)
  if (quadratic && isSingular(fit, tol = 1e-4)) {
    # Fall back to a simpler random-effects structure if the full
    # random slope for the quadratic term doesn't converge/is singular.
    f_simple <- as.formula(paste(
      outcome,
      paste0("~ 1 + ", time_term, " + ", flow_term,
             "age_at_session + BMI + hours_since_wake + med_hormone_cytokine + (1 + Time | SampleID)")
    ))
    fit <- lmer(f_simple, data = data, na.action = na.omit, REML = TRUE)
  }
  fit
}

# Flow rate is included only for CRP, DHEA, and Testosterone (the biomarkers
# expected to depend on saliva volume per unit time); dropped for the other
# 4 biomarkers.
mlm_cov_crp      <- run_mlm_cov("CRP_log",          crp_panel_cov)
mlm_cov_il10     <- run_mlm_cov("IL10_log",         cytokines_panel_cov, include_flow = FALSE)
mlm_cov_il6      <- run_mlm_cov("IL6_log",          cytokines_panel_cov, include_flow = FALSE)
mlm_cov_tnfalpha <- run_mlm_cov("TNFalpha_log",     cytokines_panel_cov, include_flow = FALSE)
mlm_cov_dhea     <- run_mlm_cov("DHEA_log",         hormones_panel_cov)
mlm_cov_test     <- run_mlm_cov("Testosterone_log", hormones_panel_cov)
mlm_cov_cort     <- run_mlm_cov("Cortisol_log",     hormones_panel_cov, include_flow = FALSE)
```

```{r covtrend-tables, results='asis'}
covtrend_models <- list(
  "CRP" = mlm_cov_crp, "IL-10" = mlm_cov_il10, "IL-6" = mlm_cov_il6, "TNF-α" = mlm_cov_tnfalpha,
  "DHEA" = mlm_cov_dhea, "Testosterone" = mlm_cov_test, "Cortisol" = mlm_cov_cort
)

term_labels <- c(
  "(Intercept)"               = "Intercept",
  "Time"                      = "Time",
  "poly(Time, 2)1"            = "Time (linear)",
  "poly(Time, 2)2"            = "Time (quadratic)",
  "flow_rate"                 = "Flow rate (mL/min)",
  "age_at_session"            = "Age at session (years)",
  "BMI"                       = "BMI",
  "hours_since_wake"          = "Hours since waking",
  "med_hormone_cytokineTRUE"  = "Hormone/cytokine-relevant medication use"
)

covtrend_group <- c(
  "CRP" = "Immune", "IL-10" = "Immune", "IL-6" = "Immune", "TNF-α" = "Immune",
  "DHEA" = "Hormones", "Testosterone" = "Hormones", "Cortisol" = "Hormones"
)

# FDR-corrected within term x group (immune markers / hormones), matching
# the primary quadratic model convention (Aim 1c).
covtrend_all_fixed <- imap_dfr(covtrend_models, function(fit, nm) {
  broom.mixed::tidy(fit, effects = "fixed") |> mutate(biomarker = nm)
}) |>
  mutate(group = unname(covtrend_group[biomarker])) |>
  group_by(term, group) |>
  mutate(p_fdr = p.adjust(p.value, method = "fdr")) |>
  ungroup()

for (nm in names(covtrend_models)) {
  cat("\n\n####", nm, "\n\n")
  # N is reported per model since it is not constant across biomarkers: any
  # participant missing hours_since_wake (available for fewer than half the
  # analytic sample) or,
  # for CRP/DHEA/Testosterone, flow_rate, is dropped from that model's fit
  # entirely (na.action = na.omit in run_mlm_cov above) -- substantially
  # smaller than the primary (unadjusted) trend models' N.
  n_model <- lme4::ngrps(covtrend_models[[nm]])
  covtrend_all_fixed |>
    filter(biomarker == nm) |>
    mutate(
      term = recode(term, !!!term_labels),
      across(c(estimate, std.error, statistic, df), \(x) round(x, 3)),
      p.value = round(p.value, 4),
      p_fdr   = round(p_fdr,   4)
    ) |>
    select(term, estimate, std.error, statistic, df, p.value, p_fdr) |>
    mutate(p_fdr = cell_spec(p_fdr, bold = !is.na(p_fdr) & p_fdr < 0.05,
      color = if_else(!is.na(p_fdr) & p_fdr < 0.05, "#2166ac", "black"))) |>
    kable(escape = FALSE,
          col.names = c("Term", "b", "SE", "t", "df", "p (raw)", "p (FDR)"),
          caption = paste0(nm, " trend model adjusted for flow rate, age, BMI, hours since waking, and hormone/cytokine-relevant medication use (N = ", n_model, " participants)")) |>
    kable_styling(bootstrap_options = "hover", full_width = FALSE) |>
    print()
}
```

```{r covtrend-results-vals, echo=FALSE, include=FALSE}
covtrend_intercepts <- covtrend_all_fixed |>
  filter(term == "(Intercept)") |>
  transmute(biomarker, estimate = round(estimate, 3), p_fdr = round(p_fdr, 4),
            sig = !is.na(p_fdr) & p_fdr < 0.05)

n_covtrend_sig  <- sum(covtrend_intercepts$sig)
covtrend_sig_text <- if (n_covtrend_sig == 0) "none" else
  paste(covtrend_intercepts$biomarker[covtrend_intercepts$sig], collapse = ", ")

covtrend_time_effects <-
  covtrend_all_fixed |> filter(term == "poly(Time, 2)1") |> select(biomarker, lin_p = p_fdr) |>
  left_join(
    covtrend_all_fixed |> filter(term == "poly(Time, 2)2") |> select(biomarker, quad_p = p_fdr),
    by = "biomarker"
  ) |>
  mutate(
    lin_sig  = !is.na(lin_p)  & lin_p  < 0.05,
    quad_sig = !is.na(quad_p) & quad_p < 0.05
  )

n_lin_sig_cov  <- sum(covtrend_time_effects$lin_sig)
n_quad_sig_cov <- sum(covtrend_time_effects$quad_sig)
lin_sig_cov_text  <- if (n_lin_sig_cov  == 0) "none" else
  paste(covtrend_time_effects$biomarker[covtrend_time_effects$lin_sig],  collapse = ", ")
quad_sig_cov_text <- if (n_quad_sig_cov == 0) "none" else
  paste(covtrend_time_effects$biomarker[covtrend_time_effects$quad_sig], collapse = ", ")

cov_term_labels <- c(
  age_at_session           = "age at session",
  BMI                      = "BMI",
  flow_rate                = "flow rate",
  hours_since_wake         = "hours since waking",
  med_hormone_cytokineTRUE = "hormone/cytokine-relevant medication use"
)

covtrend_covariate_effects <- covtrend_all_fixed |>
  filter(term %in% names(cov_term_labels)) |>
  transmute(biomarker, term, estimate, p_fdr) |>
  mutate(
    sig       = !is.na(p_fdr) & p_fdr < 0.05,
    direction = if_else(estimate > 0, "positively", "negatively")
  )

cov_clauses <- covtrend_covariate_effects |>
  filter(sig) |>
  group_by(term, direction) |>
  summarise(biomarkers = paste(biomarker, collapse = ", "), .groups = "drop") |>
  mutate(clause = paste0(unname(cov_term_labels[term]), " was ", direction,
                          " associated with ", biomarkers))

cov_clauses_text <- if (nrow(cov_clauses) == 0)
  "no covariate (flow rate, age, BMI, hours since waking, or hormone/cytokine-relevant medication use) was significantly associated with any biomarker" else
  paste0(paste(cov_clauses$clause, collapse = "; "), " (all FDR-corrected p < .05)")
```

```{r med-covariate-estimability-check, echo=FALSE, include=FALSE}
# hormone/cytokine-relevant medication use is included in run_mlm_cov()'s
# formula, but all participants flagged for it are also missing
# hours_since_wake (a required covariate in every one of these models, via
# na.action = na.omit), so the retained analytic sample for every biomarker
# has zero variance on this covariate -- lme4/lm's model-matrix construction
# silently drops a zero-variance column rather than erroring, so the term is
# absent from every model's output below despite being specified. Checked
# directly rather than assumed:
med_term_present <- any(sapply(covtrend_models, function(m) {
  "med_hormone_cytokineTRUE" %in% rownames(summary(m)$coefficients)
}))
```




**Results.** Models were specified to adjust for age, BMI, hours since waking, hormone/cytokine-relevant medication use (dummy-coded: hormonal contraceptives, other hormone medications, or systemic corticosteroids; `r sum(static_covariates$med_hormone_cytokine, na.rm = TRUE)` of `r nrow(static_covariates)` participants), and (for CRP, DHEA, and Testosterone) flow rate. `r if (!med_term_present) "The medication-use term does not appear in any of the 7 models' output below: every participant flagged for it is also missing hours_since_wake, so within each model's retained (complete-case) sample this covariate has zero variance and is silently dropped during model fitting -- it is specified but not actually estimated. A direct bivariate check of medication use against reactivity and raw levels, which does not require hours_since_wake and so retains all 3 flagged participants, is reported in the next section instead." else "The medication-use term was estimated in at least one model; see the per-biomarker tables below."` The linear time term remained significant (FDR-corrected within immune markers and hormones separately) for `r n_lin_sig_cov` of 7 biomarkers (`r lin_sig_cov_text`), and the quadratic time term remained significant for `r n_quad_sig_cov` of 7 biomarkers (`r quad_sig_cov_text`). For comparison, the primary (unadjusted) analysis found the quadratic term significantly improved fit, FDR-corrected within immune markers and hormones separately, for `r n_lrt_sig` biomarker`r if (n_lrt_sig != 1) "s"``r if (n_lrt_sig > 0) paste0(" (", lrt_sig_names, ")")` (Aim 1c); `r if (nchar(lrt_ns_names) > 0) paste0("the improvement was not significant for ", lrt_ns_names, ".")` `r n_covtrend_sig` of 7 biomarkers also showed a significant adjusted intercept (i.e., a non-zero model-implied level at the reference timepoint after accounting for these covariates): `r covtrend_sig_text`. Among the covariates themselves, `r cov_clauses_text`.

## Medication Use × Reactivity and Raw Levels (Bivariate)

*Rationale.* `r if (!med_term_present) "The covariate-adjusted trend models above specify hormone/cytokine-relevant medication use as a covariate, but it cannot actually be estimated there: within each model's complete-case sample (which also requires hours_since_wake) the term has zero variance and is silently dropped (see the note above)." else "The covariate-adjusted trend models above do estimate hormone/cytokine-relevant medication use (see the per-biomarker tables), but on the smaller complete-case sample those models require (also conditioning on hours_since_wake, flow rate, age, and BMI simultaneously)."` This section checks medication use against reactivity and raw levels directly, without requiring hours_since_wake or the other trend-model covariates, so all `r sum(static_covariates$med_hormone_cytokine, na.rm = TRUE)` flagged participants are retained. **With only `r sum(static_covariates$med_hormone_cytokine, na.rm = TRUE)` participants flagged (of `r nrow(static_covariates)`), this is a descriptive check, not an adequately powered test** -- treat any "significant" result here as hypothesis-generating at most, not confirmatory.




```{r med-reactivity-setup, echo=FALSE}
# Domain classification is keyed off the ASCII reactivity_vars name (rv),
# not the Δ-containing display label -- knitting this notebook corrupts
# multibyte characters (Δ, α, the en-dash) into literal "<U+XXXX>" text at
# the R string level, not just in the rendered HTML (confirmed by inspecting
# the Reactivity column at runtime). Matching on the Unicode label silently
# collapsed every row into one "Subjective" FDR family instead of 4
# domain-specific families; matching on the pure-ASCII variable name instead
# sidesteps that corruption entirely. Handles both the "_difference" (peak)
# and "_auci" variable-name suffixes so it works here and in S3/S5 below.
corr_domain_var <- function(rv) case_when(
  str_detect(rv, "_hr_diff$")           ~ "HR",
  str_detect(rv, "^(crp|il10|il6|tnfa)_") ~ "Immune",
  str_detect(rv, "^(dhea|test|cort)_")    ~ "Hormones",
  TRUE                                    ~ "Subjective"
)

med_reactivity <- all_difference |>
  left_join(static_covariates |> select(SampleID, med_hormone_cytokine), by = "SampleID") |>
  select(-SampleID) |>
  mutate(med_hormone_cytokine = as.numeric(med_hormone_cytokine))

med_react_corrs <- map_dfr(setNames(reactivity_vars, reactivity_labels), function(rv) {
  dat <- med_reactivity |> select(all_of(c(rv, "med_hormone_cytokine"))) |> na.omit()
  ct <- cor.test(dat[[rv]], dat$med_hormone_cytokine)
  tibble(n = nrow(dat), r = round(unname(ct$estimate), 3), p_raw = ct$p.value, domain = corr_domain_var(rv))
}, .id = "Reactivity") |>
  group_by(domain) |>
  mutate(p_fdr = round(p.adjust(p_raw, method = "fdr"), 4)) |>
  ungroup()

med_react_corrs |>
  select(Reactivity, n, r, p_fdr) |>
  mutate(p_fdr = cell_spec(p_fdr, bold = !is.na(p_fdr) & p_fdr < 0.05,
    color = if_else(!is.na(p_fdr) & p_fdr < 0.05, "#2166ac", "black"))) |>
  kable(escape = FALSE, col.names = c("Reactivity outcome", "n", "r", "p (FDR)"),
        caption = paste0("Correlations: hormone/cytokine-relevant medication use x reactivity, all 13 outcomes (FDR within domain; bold = p_FDR < .05; descriptive only, n = ",
                          sum(static_covariates$med_hormone_cytokine, na.rm = TRUE), " flagged)")) |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```

```{r med-reactivity-results-vals, echo=FALSE, include=FALSE}
sig_med_react <- med_react_corrs |> filter(p_fdr < 0.05)
n_sig_med_react <- nrow(sig_med_react)
med_react_sig_text <- if (n_sig_med_react == 0) {
  "No significant associations were observed after FDR correction"
} else {
  paste(paste0(sig_med_react$Reactivity, " (r = ", sig_med_react$r, ", p~FDR~ = ", sig_med_react$p_fdr, ")"), collapse = "; ")
}
```




**Results.** `r if (n_sig_med_react == 0) "No significant associations survived FDR correction." else paste0(n_sig_med_react, " significant association", if (n_sig_med_react != 1) "s were" else " was", " observed: ", med_react_sig_text, ".")` Raw biomarker-level correlations for this same predictor (all 4 timepoints) are reported under "Hormone/Cytokine-Relevant Medication Use (0/1)" in the Individual-Difference Measures × Raw Biomarker Levels section above.

## S3: AUCi-Based Reactivity

*Rationale.* The peak-vs-T1 reactivity tests used throughout this supplement and the primary notebook take, for each biomarker and participant, whichever of T3/T4 is higher — a data-driven, per-person operationalization that could inflate apparent reactivity by selecting each individual's own maximum. As a sensitivity check, this section instead uses the area under the curve with respect to increase (AUCi; Pruessner et al., 2003), which summarizes the entire T1–T4 trajectory relative to baseline rather than any single timepoint. AUCi is computed from each participant's own sample-collection times using the trapezoid rule, matching the primary notebook's Aim 1c (continued) Sensitivity Analysis: AUCi section exactly, re-pointed at this notebook's own independently-built dataframes. One-sample two-tailed t-tests (against μ = 0) are used, matching the two-tailed convention used throughout both notebooks.




```{r s3-auci-setup, echo=FALSE}
# BFNES/CES-DC (bfnes/dep) are loaded earlier now, in the
# Individual-Difference Measures × Raw Biomarker Levels setup chunk above
# (indiff-levels-setup), since that section also needs them and runs first.

# AUCi, computed via the trapezoid rule -- identical formula to the primary
# notebook. Elapsed times use this notebook's own (immune-panel-anchored)
# saliva_timing columns (elapsed_i_T2-4), which are built the same way as the
# primary notebook's elapsed_T2-4 (both derive from the X1i_start/X2i_start/...
# sample-report columns) -- so this is the same clock, not a different one.
compute_auci <- function(m1, m2, m3, m4, t2, t3, t4) {
  (m1 + m2) / 2 * t2 +
    (m2 + m3) / 2 * (t3 - t2) +
    (m3 + m4) / 2 * (t4 - t3) -
    m1 * t4
}

auci_data <- sos_crp_wide |>
  select(SampleID, CRP_log_1, CRP_log_2, CRP_log_3, CRP_log_4) |>
  full_join(
    sos_cytokines_wide |>
      select(SampleID,
             IL10_log_1, IL10_log_2, IL10_log_3, IL10_log_4,
             IL6_log_1, IL6_log_2, IL6_log_3, IL6_log_4,
             TNFalpha_log_1, TNFalpha_log_2, TNFalpha_log_3, TNFalpha_log_4),
    by = "SampleID"
  ) |>
  full_join(
    sos_hormones_wide |>
      select(SampleID,
             DHEA_log_1, DHEA_log_2, DHEA_log_3, DHEA_log_4,
             Testosterone_log_1, Testosterone_log_2, Testosterone_log_3, Testosterone_log_4,
             Cortisol_log_1, Cortisol_log_2, Cortisol_log_3, Cortisol_log_4),
    by = "SampleID"
  ) |>
  left_join(saliva_timing |> select(SampleID, elapsed_i_T2, elapsed_i_T3, elapsed_i_T4), by = "SampleID") |>
  mutate(
    crp_auci  = compute_auci(CRP_log_1, CRP_log_2, CRP_log_3, CRP_log_4,
                              elapsed_i_T2, elapsed_i_T3, elapsed_i_T4),
    il10_auci = compute_auci(IL10_log_1, IL10_log_2, IL10_log_3, IL10_log_4,
                              elapsed_i_T2, elapsed_i_T3, elapsed_i_T4),
    il6_auci  = compute_auci(IL6_log_1, IL6_log_2, IL6_log_3, IL6_log_4,
                              elapsed_i_T2, elapsed_i_T3, elapsed_i_T4),
    tnfa_auci = compute_auci(TNFalpha_log_1, TNFalpha_log_2, TNFalpha_log_3, TNFalpha_log_4,
                              elapsed_i_T2, elapsed_i_T3, elapsed_i_T4),
    dhea_auci = compute_auci(DHEA_log_1, DHEA_log_2, DHEA_log_3, DHEA_log_4,
                              elapsed_i_T2, elapsed_i_T3, elapsed_i_T4),
    test_auci = compute_auci(Testosterone_log_1, Testosterone_log_2, Testosterone_log_3, Testosterone_log_4,
                              elapsed_i_T2, elapsed_i_T3, elapsed_i_T4),
    cort_auci = compute_auci(Cortisol_log_1, Cortisol_log_2, Cortisol_log_3, Cortisol_log_4,
                              elapsed_i_T2, elapsed_i_T3, elapsed_i_T4)
  )

run_auci_test <- function(col) t.test(auci_data[[col]], mu = 0, alternative = "two.sided")

auci_tests_raw <- list(
  crp  = run_auci_test("crp_auci"),
  il10 = run_auci_test("il10_auci"),
  il6  = run_auci_test("il6_auci"),
  tnfa = run_auci_test("tnfa_auci"),
  dhea = run_auci_test("dhea_auci"),
  test = run_auci_test("test_auci"),
  cort = run_auci_test("cort_auci")
)
auci_praw <- map_dbl(auci_tests_raw, \(t) t$p.value)
auci_pfdr <- setNames(
  c(
    p.adjust(auci_praw[1:4], method = "fdr"),
    p.adjust(auci_praw[5:7], method = "fdr")
  ),
  names(auci_praw)
)

auci_ttest_tbl <- auci_tests_raw |>
  map(broom::tidy) |>
  list_rbind(names_to = "biomarker") |>
  mutate(
    n = auci_tests_raw |> map_dbl(\(t) unname(t$parameter) + 1),
    biomarker = case_match(
      biomarker,
      "crp" ~ "CRP", "il10" ~ "IL-10", "il6" ~ "IL-6", "tnfa" ~ "TNF-alpha",
      "dhea" ~ "DHEA", "test" ~ "Testosterone", "cort" ~ "Cortisol"
    )
  ) |>
  select(biomarker, n, estimate, statistic, parameter, p.value) |>
  mutate(across(where(is.numeric), \(x) round(x, 3)))

# AUCi-based counterpart to reactivity_vars/all_difference (already built
# above for this notebook's own peak-based reactivity): HR and
# subjective-stress columns are unchanged; only the 7 biomarker columns are
# swapped for their AUCi equivalents.
reactivity_vars_auci <- c(
  "task_rs_hr_diff", "conn_dis_hr_diff", "conn_other_hr_diff", "conn_rest_hr_diff",
  "crp_auci", "il10_auci", "il6_auci", "tnfa_auci",
  "dhea_auci", "test_auci", "cort_auci",
  "subj_scsd_difference", "subj_scother_difference"
)

all_difference_auci <- all_difference |>
  select(SampleID, task_rs_hr_diff, conn_dis_hr_diff, conn_other_hr_diff, conn_rest_hr_diff,
         subj_scsd_difference, subj_scother_difference) |>
  left_join(
    auci_data |> select(SampleID, crp_auci, il10_auci, il6_auci, tnfa_auci,
                         dhea_auci, test_auci, cort_auci),
    by = "SampleID"
  )
```




### One-Sample AUCi Tests




```{r s3-auci-table}
auci_ttest_tbl |>
  mutate(p.value = cell_spec(p.value, bold = p.value < 0.05,
    color = if_else(p.value < 0.05, "#2166ac", "black"))) |>
  kable(col.names = c("biomarker", "N", "Mean AUCi", "t", "df", "p (two-tailed)"), escape = FALSE) |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```

```{r s3-auci-fdr}
auci_fdr_tbl <- tibble(
  group     = c(rep("Immune", 4), rep("Hormones", 3)),
  biomarker = c("CRP", "IL-10", "IL-6", "TNF-alpha", "DHEA", "Testosterone", "Cortisol"),
  n         = auci_ttest_tbl$n,
  p_raw     = round(auci_praw, 6),
  p_fdr     = auci_pfdr
)

auci_fdr_tbl |>
  mutate(p_fdr = cell_spec(round(p_fdr, 4), bold = p_fdr < 0.05,
    color = if_else(p_fdr < 0.05, "#2166ac", "black"))) |>
  kable(col.names = c("Group", "biomarker", "N", "p (raw)", "p (FDR)"), escape = FALSE) |>
  kable_styling(bootstrap_options = "hover", full_width = FALSE)
```

```{r s3-auci-results-vals, echo=FALSE, include=FALSE}
# AUCi is signed (unlike peak-minus-baseline, which only tests for an
# increase), so "significant" must be split by direction here too, matching
# the primary notebook's Aim 1c (continued) AUCi section.
auci_signed <- auci_fdr_tbl |>
  left_join(auci_ttest_tbl |> select(biomarker, estimate), by = "biomarker")

sig_auci_increase <- auci_signed |> filter(p_fdr < 0.05, estimate > 0) |> pull(biomarker)
sig_auci_decrease <- auci_signed |> filter(p_fdr < 0.05, estimate < 0) |> pull(biomarker)

fmt_or_none <- function(x) if (length(x) == 0) "none" else paste(x, collapse = ", ")
```




**Results.** Using AUCi as an alternative, trajectory-based reactivity index, `r fmt_or_none(sig_auci_increase)` showed a significant net *increase* over baseline, and `r fmt_or_none(sig_auci_decrease)` showed a significant net *decrease* (FDR-corrected within immune markers and hormones separately). These match the primary notebook's Aim 1c (continued) AUCi results, computed here independently from this notebook's own dataframes as a self-containment check.

### Pubertal Status & Timing × Reactivity: Peak vs. AUCi

Same design as the primary notebook's Aim 2: bivariate Pearson correlations between each of the 13 reactivity outcomes and pubertal status (PUBcomp), age at menarche (centered), and PDS F5 perceived timing, FDR-corrected within each reactivity domain. The peak-based matrix is recomputed here (it is not otherwise built in this notebook) so it can be directly compared against the AUCi-based version.




```{r s3-puberty-peak-corr, echo=FALSE}
all_pub_mat <- timing_reactivity |>
  select(all_of(c(all_pub_vars, reactivity_vars))) |>
  as.matrix()
colnames(all_pub_mat) <- c(all_pub_labels, reactivity_labels)

all_pub_corrs <- rcorr(all_pub_mat)

raw_allpub_mat <- all_pub_corrs$P[all_pub_labels, reactivity_labels, drop = FALSE]
fdr_allpub_mat <- raw_allpub_mat
for (pv in all_pub_labels) {
  for (cols in list(hr_cols, imm_cols, horm_cols, subj_cols)) {
    fdr_allpub_mat[pv, cols] <- p.adjust(raw_allpub_mat[pv, cols], method = "fdr")
  }
}
r_mat <- all_pub_corrs$r[all_pub_labels, reactivity_labels, drop = FALSE]
```

```{r s3-puberty-auci-corr, echo=FALSE}
timing_reactivity_auci <- all_difference_auci |>
  left_join(timing_df, by = "SampleID")

all_pub_mat_auci <- timing_reactivity_auci |>
  select(all_of(c(all_pub_vars, reactivity_vars_auci))) |>
  as.matrix()
colnames(all_pub_mat_auci) <- c(all_pub_labels, reactivity_labels)

all_pub_corrs_auci <- rcorr(all_pub_mat_auci)

raw_allpub_mat_auci <- all_pub_corrs_auci$P[all_pub_labels, reactivity_labels, drop = FALSE]
fdr_allpub_mat_auci <- raw_allpub_mat_auci
for (pv in all_pub_labels) {
  for (cols in list(hr_cols, imm_cols, horm_cols, subj_cols)) {
    fdr_allpub_mat_auci[pv, cols] <- p.adjust(raw_allpub_mat_auci[pv, cols], method = "fdr")
  }
}
r_mat_auci <- all_pub_corrs_auci$r[all_pub_labels, reactivity_labels, drop = FALSE]
```

```{r s3-puberty-head-to-head}
# Restricted to the 7 biomarker-reactivity outcomes, since HR and subjective
# stress are identical between the peak and AUCi matrices (only the biomarker
# columns differ) and are not repeated here.
peak_vs_auci_pub <- expand.grid(pv = all_pub_labels, rv = reactivity_labels[5:11],
                                 stringsAsFactors = FALSE) |>
  rowwise() |>
  mutate(
    r_peak     = round(r_mat[pv, rv], 3),
    p_fdr_peak = round(fdr_allpub_mat[pv, rv], 4),
    r_auci     = round(r_mat_auci[pv, rv], 3),
    p_fdr_auci = round(fdr_allpub_mat_auci[pv, rv], 4)
  ) |>
  ungroup()

peak_vs_auci_pub |>
  mutate(across(c(p_fdr_peak, p_fdr_auci), \(x) cell_spec(
    x, bold = !is.na(x) & x < 0.05, color = if_else(!is.na(x) & x < 0.05, "#2166ac", "black")
  ))) |>
  kable(escape = FALSE,
        col.names = c("Predictor", "Reactivity outcome", "r (peak)", "p_FDR (peak)", "r (AUCi)", "p_FDR (AUCi)"),
        caption = "Pubertal status/timing x biomarker reactivity: peak-based vs. AUCi-based (bold = p_FDR < .05)") |>
  kable_styling(bootstrap_options = "hover")
```

```{r s3-puberty-index-dependent, echo=FALSE, include=FALSE}
# "Index-dependent": significant under peak-based reactivity but not under
# AUCi -- computed from the actual p-values each render, not hardcoded.
pub_index_dependent <- peak_vs_auci_pub |>
  filter(p_fdr_peak < 0.05, is.na(p_fdr_auci) | p_fdr_auci >= 0.05)
pub_index_dependent_text <- if (nrow(pub_index_dependent) == 0) NULL else
  paste(paste0(pub_index_dependent$pv, " × ", pub_index_dependent$rv), collapse = ", ")
```




**Results.** Full peak-vs-AUCi head-to-head values for all pubertal-status/timing × biomarker-reactivity pairs are shown above. `r if (!is.null(pub_index_dependent_text)) paste0("The association", if (nrow(pub_index_dependent) != 1) "s" else "", " between ", pub_index_dependent_text, " should be considered index-dependent: significant under peak-based reactivity but not under the AUCi-based sensitivity check.") else "No pair that was significant under peak-based reactivity lost significance under the AUCi-based sensitivity check."`

### FNE (BFNES) × Reactivity: Peak vs. AUCi




```{r s3-bfnes-corr, echo=FALSE}
bfnes_reactivity <- all_difference |>
  left_join(bfnes, by = "SampleID") |>
  select(-SampleID)

# corr_domain_var() is now defined earlier (Medication Use x Reactivity
# section above), since that section needs it too and runs first.

# Pairwise-complete: each reactivity outcome is tested on its own available n
# (na.omit() on just that outcome + BFNES_total), matching the pairwise
# convention the puberty/timing correlation matrix (rcorr()) already uses.
# Previously this ran a single na.omit() on the full 13-column frame first,
# so every outcome was tested on the same listwise-complete n regardless of
# whether that outcome itself needed HR data to be non-missing.
bfnes_react_corrs <- map_dfr(setNames(reactivity_vars, reactivity_labels), function(rv) {
  dat <- bfnes_reactivity |> select(all_of(c(rv, "BFNES_total"))) |> na.omit()
  ct <- cor.test(dat[[rv]], dat$BFNES_total)
  tibble(n = nrow(dat), r = round(unname(ct$estimate), 3), p_raw = ct$p.value, domain = corr_domain_var(rv))
}, .id = "Reactivity") |>
  group_by(domain) |>
  mutate(p_fdr = round(p.adjust(p_raw, method = "fdr"), 4)) |>
  ungroup()

bfnes_reactivity_auci <- all_difference_auci |>
  left_join(bfnes, by = "SampleID") |>
  select(-SampleID)

bfnes_react_corrs_auci <- map_dfr(setNames(reactivity_vars_auci, reactivity_labels), function(rv) {
  dat <- bfnes_reactivity_auci |> select(all_of(c(rv, "BFNES_total"))) |> na.omit()
  ct <- cor.test(dat[[rv]], dat$BFNES_total)
  tibble(n = nrow(dat), r = round(unname(ct$estimate), 3), p_raw = ct$p.value, domain = corr_domain_var(rv))
}, .id = "Reactivity") |>
  group_by(domain) |>
  mutate(p_fdr = round(p.adjust(p_raw, method = "fdr"), 4)) |>
  ungroup()

bfnes_peak_vs_auci <- bfnes_react_corrs |>
  select(Reactivity, n_peak = n, r_peak = r, p_fdr_peak = p_fdr) |>
  left_join(bfnes_react_corrs_auci |> select(Reactivity, n_auci = n, r_auci = r, p_fdr_auci = p_fdr), by = "Reactivity")

bfnes_peak_vs_auci |>
  mutate(across(c(p_fdr_peak, p_fdr_auci), \(x) cell_spec(
    x, bold = !is.na(x) & x < 0.05, color = if_else(!is.na(x) & x < 0.05, "#2166ac", "black")
  ))) |>
  kable(escape = FALSE,
        col.names = c("Reactivity outcome", "n (peak)", "r (peak)", "p_FDR (peak)", "n (AUCi)", "r (AUCi)", "p_FDR (AUCi)"),
        caption = "BFNES x reactivity: peak-based vs. AUCi-based, all 13 outcomes (pairwise-complete n; bold = p_FDR < .05)") |>
  kable_styling(bootstrap_options = "hover")
```

```{r s3-bfnes-index-dependent, echo=FALSE, include=FALSE}
